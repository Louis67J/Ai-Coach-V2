# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Environnement
.env
.env.local

# Données et outputs (générés, pas versionnés)
# Note: "data/*" (pas "data/") est nécessaire pour que les exceptions
# ci-dessous marchent — Git ne descend jamais dans un dossier exclu via
# un pattern de dossier ("data/"), donc les "!" suivants seraient ignorés.
data/*
!data/profile.json
!data/sessions.json
outputs/
*.log

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db